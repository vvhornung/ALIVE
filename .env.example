# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Client identity: the wallet address that owns the developer key
OP_WALLET_ADDRESS_URL=
# Key ID (UUID) shown in the test wallet under Settings > Developer Keys
OP_KEY_ID=
# Private key: a file path (e.g. ./private.key) or the PEM text...
OP_PRIVATE_KEY=
# ...or the PEM encoded as base64 (for hosts without a filesystem)
OP_PRIVATE_KEY_B64=

APP_BASE_URL=http://localhost:3000
# REQUIRED: 32 random bytes, base64. Encrypts stored grant tokens.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# true = reject callbacks whose interact hash does not match
STRICT_HASH=false

# SQLite file (folder is created on first use; *.db is gitignored)
DATABASE_PATH=./data/alive.db

# Spike scripts only (npm run spike:s0 / spike:s2)
SPIKE_PAYER_WALLET=
SPIKE_RECIPIENT_A_WALLET=
SPIKE_RECIPIENT_B_WALLET=

# Demo setup only (npm run demo:setup; the app must be running)
DEMO_FREELANCER_WALLET=
DEMO_FREELANCER_NAME=
DEMO_RENT_WALLET=
DEMO_PILA_WALLET=
# Optional: if set, demo:setup also starts the payer approval and prints the consent URL
DEMO_PAYER_WALLET=
# Optional (defaults: 3.00 total = 1.50 Me + 1.00 Rent + 0.50 PILA, USD, due today in Bogotá)
DEMO_AMOUNT=
DEMO_ASSET_CODE=
DEMO_ME_AMOUNT=
DEMO_RENT_AMOUNT=
DEMO_PILA_AMOUNT=
DEMO_DUE_AT=
