# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Client identity: the wallet address that owns the developer key
OP_WALLET_ADDRESS_URL=
# Key ID (UUID) shown in the test wallet under Settings > Developer Keys
OP_KEY_ID=
# Private key: a file path (e.g. ./private.key) or the PEM text...
OP_PRIVATE_KEY=
# ...or the PEM encoded as base64 (for hosts without a filesystem)
OP_PRIVATE_KEY_B64=

APP_BASE_URL=http://localhost:3000
# 32 random bytes, base64 (optional until stored tokens are encrypted)
ENCRYPTION_KEY=
# true = reject callbacks whose interact hash does not match
STRICT_HASH=false

# Spike scripts only (npm run spike:s0 / spike:s2)
SPIKE_PAYER_WALLET=
SPIKE_RECIPIENT_A_WALLET=
SPIKE_RECIPIENT_B_WALLET=
